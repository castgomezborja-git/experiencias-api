<?xml version="1.0" encoding="UTF-8"?>
<!-- src/Experience/Infrastructure/Persistence/Mapping/Experience.orm.xml -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Experience\Domain\Model\Experience" table="experiences">

        <id name="id" type="experience_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="title" type="string" length="255" column="title"/>
        <field name="description" type="text" column="description"/>
        <field name="providerId" type="provider_id" column="provider_id"/>

    </entity>
</doctrine-mapping>