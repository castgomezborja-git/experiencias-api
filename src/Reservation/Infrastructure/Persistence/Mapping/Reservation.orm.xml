<?xml version="1.0" encoding="UTF-8"?>
<!-- src/Reservation/Infrastructure/Persistence/Mapping/Reservation.orm.xml -->
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                   https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Reservation\Domain\Model\Reservation" table="reservations">

        <id name="id" type="reservation_id" column="id">
            <generator strategy="NONE"/>
        </id>

        <field name="sessionId" type="session_id" column="session_id"/>
        <field name="userId" type="user_id" column="user_id"/>
        <field name="seats" type="integer" column="seats"/>
        <field name="totalPrice" type="integer" column="total_price"/>
        <field name="status" column="status" enum-type="App\Reservation\Domain\Model\ValueObject\ReservationStatus"/>

    </entity>
</doctrine-mapping>